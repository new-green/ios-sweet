diff --git a/bsd/conf/Makefile.template b/bsd/conf/Makefile.template
--- a/bsd/conf/Makefile.template
+++ b/bsd/conf/Makefile.template
@@ -44,8 +44,8 @@
         -Warray-bounds-pointer-arithmetic
 SFLAGS+= -include meta_features.h
 
-# This provider is built into SWEET; other boards use their normal kext.
-ifeq ($(CURRENT_MACHINE_CONFIG),SWEET)
+# This provider is built into SWEET and PACMAN; other boards use their normal kext.
+ifneq ($(filter $(CURRENT_MACHINE_CONFIG),SWEET PACMAN),)
 SWEET_PTHREAD_ROOT = $(SRCROOT)/bsd/pthread/sweet_libpthread
 SWEET_PTHREAD_INC = -I$(SWEET_PTHREAD_ROOT) -I$(SWEET_PTHREAD_ROOT)/private -I$(SWEET_PTHREAD_ROOT)/include
 sweet_pthread_init.o_INCFLAGS = $(SWEET_PTHREAD_INC)
diff --git a/bsd/kern/bsd_init.c b/bsd/kern/bsd_init.c
--- a/bsd/kern/bsd_init.c
+++ b/bsd/kern/bsd_init.c
@@ -691,8 +691,8 @@
 	bsd_init_kprintf("calling vfsinit\n");
 	vfsinit();
 
-#if defined(ARM64_BOARD_CONFIG_SWEET)
-	/* AMFI's MAC policy is built in on SWEET (bsd/kern/sweet_amfi.c). */
+#if defined(ARM64_BOARD_CONFIG_SWEET) || defined(ARM64_BOARD_CONFIG_PACMAN)
+	/* AMFI's MAC policy is built in on SWEET/PACMAN (bsd/kern/sweet_amfi.c). */
 	extern void sweet_amfi_policy_register(void);
 	sweet_amfi_policy_register();
 #endif
@@ -933,10 +933,10 @@
 		if (require_rootauth) {
 			/* enforce sealedness */
 			int autherr = VNOP_IOCTL(rootvnode, FSIOC_KERNEL_ROOTAUTH, NULL, 0, vfs_context_kernel());
-#if defined(ARM64_BOARD_CONFIG_SWEET)
+#if defined(ARM64_BOARD_CONFIG_SWEET) || defined(ARM64_BOARD_CONFIG_PACMAN)
 			/*
-			 * SWEET has no chain of trust to extend: the kernel itself is
-			 * booted unsigned and there is no Image4/AMFI, and its HFS root
+			 * SWEET/PACMAN have no chain of trust to extend: the kernel itself
+			 * is booted unsigned and there is no Image4/AMFI, and its HFS root
 			 * cannot be a sealed volume. Report it instead of panicking.
 			 */
 			if (autherr) {
diff --git a/libkern/conf/Makefile.template b/libkern/conf/Makefile.template
--- a/libkern/conf/Makefile.template
+++ b/libkern/conf/Makefile.template
@@ -19,7 +19,9 @@
 CFLAGS+= -include meta_features.h -DLIBKERN_KERNEL_PRIVATE -DOSALLOCDEBUG=1
 SFLAGS+= -include meta_features.h
 
-ifeq ($(CURRENT_MACHINE_CONFIG),SWEET)
+# BearSSL's portable AES, MD5, SHA-1 and SHA-384/512 are built into SWEET and
+# PACMAN; other boards get them from the corecrypto kext.
+ifneq ($(filter $(CURRENT_MACHINE_CONFIG),SWEET PACMAN),)
 SWEET_AES_ROOT = $(SRCROOT)/libkern/crypto/sweet_bearssl
 SWEET_AES_INC = -I$(SWEET_AES_ROOT)/inc -I$(SWEET_AES_ROOT)/src
 sweet_aes.o_INCFLAGS = $(SWEET_AES_INC)
